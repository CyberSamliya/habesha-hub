+/* ---- v2 additions (directory architecture) ---- */
+:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
+.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
+.icon{display:inline-block}
+.filters{grid-template-columns:1.4fr 1fr 1fr 1fr 1fr auto}
+.filters label.f{display:flex;flex-direction:column;gap:4px;font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--muted)}
+.filters select:disabled{background:#f4f3ee;color:#8a918c}
+.filters .clear-wrap{display:flex;align-items:flex-end}
+.filters .clear-wrap button{width:100%}
+.filter-extra{display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin:-6px 0 8px;font-size:.88rem;color:var(--muted)}
+.filter-extra label{display:inline-flex;gap:6px;align-items:center;cursor:pointer}
+.hidden{display:none!important}
+.city-group{grid-column:1/-1;margin:14px 0 -4px;font-family:"Playfair Display",serif;font-size:1.35rem;border-bottom:1px solid var(--line);padding-bottom:4px}
+.city-group small{font-family:Inter,Arial,sans-serif;font-size:.8rem;color:var(--muted);font-weight:600;margin-left:6px}
+.listing address{font-style:normal;color:var(--muted);font-size:.9rem}
+.listing .meta-line{font-size:.8rem;color:var(--muted)}
+.listing .note{font-size:.82rem;color:#6b5a2c;background:#fff8e7;border-radius:8px;padding:6px 8px}
+.badge.s-verified{background:#e6f3ea;color:#17613a}
+.badge.s-community{background:#eef1f7;color:#2d4775}
+.badge.s-needs-review{background:#fff3db;color:#7a5410}
+.badge.s-temporarily-closed{background:#fde9e4;color:#8b3528}
+.listing-actions{flex-wrap:wrap;gap:8px 12px}
+.listing-actions a{display:inline-flex;align-items:center;min-height:32px}
+.listing-actions a.pri{background:var(--green);color:#fff;border-radius:8px;padding:4px 10px;text-decoration:none}
+.listing-actions a.sec{border:1px solid var(--line);border-radius:8px;padding:4px 10px;text-decoration:none}
+.listing-actions .minor{font-size:.78rem;font-weight:600;color:var(--muted)}
+.more-wrap{text-align:center;margin-top:18px}
+.chips{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
+.chip{border:1px solid var(--line);background:#fff;border-radius:20px;padding:6px 12px;font-size:.85rem;font-weight:600;color:var(--green);cursor:pointer}
+.chip:hover{border-color:var(--gold)}
+.coverage{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin-top:22px}
+.coverage button{text-align:left;border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 11px;cursor:pointer;font-size:.86rem;color:var(--ink)}
+.coverage button span{display:block;font-size:.74rem;color:var(--muted)}
+.coverage button.has{border-color:#b9cdbf;background:#f4faf6}
+.coverage button[aria-pressed="true"]{outline:2px solid var(--green)}
+.housing-rules{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:18px}
+.status-pill{display:inline-block;border-radius:20px;padding:3px 8px;font-size:.72rem;font-weight:800}
+.status-pill.active{background:#e6f3ea;color:#17613a}.status-pill.recheck{background:#fff3db;color:#7a5410}.status-pill.expired{background:#eee;color:#555}
+.contrib:hover,.contrib:focus-visible{background:rgba(255,255,255,.08)}
+.review-note{margin-top:18px;color:#dbe7e0;font-size:.9rem}
+.eyebrow.light{color:#e5c76f}
+@media(max-width:1000px){.filters{grid-template-columns:1fr 1fr 1fr}.housing-rules{grid-template-columns:1fr}}
+@media(max-width:620px){.filters{grid-template-columns:1fr}.coverage{grid-template-columns:repeat(2,1fr)}}
+@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.cat{transition:none}}
+.contrib{min-width:0;overflow-wrap:anywhere}.listing{min-width:0;overflow-wrap:anywhere}
+@media(max-width:900px){.contribute-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
+@media(max-width:620px){.contribute-grid{grid-template-columns:1fr}}
