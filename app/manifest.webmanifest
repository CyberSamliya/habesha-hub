{
  "name": "Habesha Hub",
  "short_name": "Habesha Hub",
  "description": "Ethiopian and Habesha community directory for the USA: restaurants, churches, groceries, services and newcomer resources.",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fbfaf6",
  "theme_color": "#173b2c",
  "lang": "en",
  "categories": ["lifestyle", "social", "travel"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Directory", "url": "/app/#search", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Saved places", "url": "/app/#saved", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
